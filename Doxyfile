# Doxyfile for layered-embedded-c
# 覆盖全部自有业务代码目录（User/、BSP/、Framework/{Core,Control,Drivers,Chassis}/）。

PROJECT_NAME           = "layered-embedded-c"
PROJECT_BRIEF          = "STM32F407VET6 分层嵌入式 C11 工程"
OUTPUT_DIRECTORY       = build/docs
CREATE_SUBDIRS         = NO
OUTPUT_LANGUAGE        = English

OPTIMIZE_OUTPUT_FOR_C  = YES
JAVADOC_AUTOBRIEF      = YES
EXTRACT_ALL            = NO
EXTRACT_STATIC         = YES

INPUT                  = User \
                         BSP/Inc BSP/Src \
                         Framework/Core/Inc Framework/Core/Src \
                         Framework/Control/Inc Framework/Control/Src \
                         Framework/Drivers/Inc Framework/Drivers/Src \
                         Framework/Chassis/Inc Framework/Chassis/Src
FILE_PATTERNS          = *.h *.c
RECURSIVE              = NO
EXCLUDE_PATTERNS       = */ThirdParty/*

QUIET                  = YES
WARNINGS               = YES
WARN_IF_UNDOCUMENTED   = YES
WARN_IF_DOC_ERROR      = YES
WARN_NO_PARAMDOC       = NO
WARN_AS_ERROR          = YES

GENERATE_HTML          = NO
GENERATE_LATEX         = NO
GENERATE_XML           = YES
