PROJECT_NAME           = "layered-embedded-c"
PROJECT_BRIEF          = "面向 STM32F4 与 STM32F1 的分层嵌入式 C 基础设施"
OUTPUT_DIRECTORY       = build/doxygen
CREATE_SUBDIRS         = NO
OUTPUT_LANGUAGE        = Chinese
OPTIMIZE_OUTPUT_FOR_C  = YES
MARKDOWN_SUPPORT       = YES
AUTOLINK_SUPPORT       = YES
JAVADOC_AUTOBRIEF      = YES

EXTRACT_ALL            = NO
EXTRACT_PRIVATE        = NO
EXTRACT_STATIC         = NO

INPUT                  = README.md \
                         doc/architecture.md \
                         doc/imu.md \
                         doc/platform.md \
                         doc/platform-contract.md \
                         doc/units.md \
                         doc/conventions.md \
                         doc/telemetry.md \
                         doc/todo.md \
                         doc/README.md \
                         doc/doxygen/mainpage.md \
                         doc/doxygen/groups.dox \
                         Boards/f103c8t6-platform-test/README.md \
                         Boards/f103c8t6-platform-test/hardware-map.md \
                         Boards/f103c8t6-platform-test/App \
                         Boards/f103c8t6-platform-test/RTOS \
                         Boards/f103c8t6-platform-test/Test \
                         Boards/f103c8t6-fast-channel-task-1/README.md \
                         Boards/f103c8t6-fast-channel-task-1/hardware-map.md \
                         Boards/f103c8t6-fast-channel-task-1/App \
                         Boards/f103c8t6-fast-channel-task-1/RTOS \
                         Boards/f407vet6-omni-car/README.md \
                         Boards/f407vet6-omni-car/pinmap.md \
                         Boards/f407vet6-omni-car/hardware-map.md \
                         Boards/f407vet6-omni-car/App \
                         Boards/f407vet6-omni-car/RTOS \
                         tools/rtt/README.md \
                         cmake/platform-check/README.md \
                         cmake/platform-test \
                         Platform \
                         DeviceDrivers \
                         Controller \
                         Policy \
                         Filter \
                         System
FILE_PATTERNS          = *.c *.h *.md *.dox
RECURSIVE              = YES
EXCLUDE                = build Drivers Middlewares Core cmake/stm32cubemx
EXCLUDE_PATTERNS       = */build/*
INPUT_ENCODING         = UTF-8
SEARCH_INCLUDES        = NO

USE_MDFILE_AS_MAINPAGE = doc/doxygen/mainpage.md

GENERATE_HTML          = YES
HTML_OUTPUT            = html
GENERATE_LATEX         = NO
GENERATE_TREEVIEW      = YES

HAVE_DOT               = NO
CALL_GRAPH             = NO
CALLER_GRAPH           = NO

WARN_IF_UNDOCUMENTED   = NO
WARN_IF_DOC_ERROR      = YES
QUIET                  = YES

PREDEFINED             = USE_FREERTOS STM32F4xx \
                         PLATFORM_ENABLE_PWM_TIM1=1 \
                         PLATFORM_ENABLE_PWM_TIM2=1 \
                         PLATFORM_ENABLE_PWM_TIM3=1 \
                         PLATFORM_ENABLE_PWM_TIM4=1 \
                         PLATFORM_ENABLE_ENCODER_TIM2=1 \
                         PLATFORM_ENABLE_ENCODER_TIM3=1 \
                         PLATFORM_ENABLE_ENCODER_TIM4=1 \
                         PLATFORM_ENABLE_ENCODER_TIM5=1 \
                         PLATFORM_ENABLE_UART1=1 \
                         PLATFORM_ENABLE_UART2=1 \
                         PLATFORM_ENABLE_UART3=1 \
                         PLATFORM_ENABLE_UART4=1 \
                         PLATFORM_ENABLE_UART5=1 \
                         PLATFORM_ENABLE_UART6=1 \
                         PLATFORM_ENABLE_I2C1=1 \
                         PLATFORM_ENABLE_I2C2=1 \
                         PLATFORM_ENABLE_I2C3=1 \
                         PLATFORM_ENABLE_SPI1=1 \
                         PLATFORM_ENABLE_SPI2=1 \
                         PLATFORM_ENABLE_SPI3=1 \
                         PLATFORM_ENABLE_ADC1=1 \
                         PLATFORM_ENABLE_ADC2=1 \
                         PLATFORM_ENABLE_ADC3=1 \
                         PLATFORM_ENABLE_DAC1=1 \
                         PLATFORM_ENABLE_CAN1=1 \
                         PLATFORM_ENABLE_CAN2=1 \
                         PLATFORM_ENABLE_RTC=1 \
                         PLATFORM_ENABLE_FLASH=1 \
                         PLATFORM_ENABLE_CRC=1 \
                         PLATFORM_ENABLE_RNG=1 \
                         PLATFORM_ENABLE_IWDG=1 \
                         PLATFORM_ENABLE_WWDG=1
INCLUDE_PATH           = Platform/Inc \
                         DeviceDrivers/Base/Inc \
                         DeviceDrivers/Inc \
                         Controller/Base/Inc \
                         Controller/Inc \
                         Policy/Base/Inc \
                         Policy/Inc \
                         Filter/Base/Inc \
                         Filter/Inc \
                         System/Inc \
                         Boards/f103c8t6-platform-test/App/Inc \
                         Boards/f103c8t6-platform-test/RTOS/Inc \
                         Boards/f103c8t6-platform-test/Test/Inc \
                         Boards/f103c8t6-fast-channel-task-1/App/Inc \
                         Boards/f103c8t6-fast-channel-task-1/RTOS/Inc \
                         Boards/f407vet6-omni-car/App/Inc \
                         Boards/f407vet6-omni-car/RTOS/Inc
