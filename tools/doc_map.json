{
  "$comment": "文档驱动映射（v2）：修改匹配路径前必须先阅读对应文档（.agents/hooks/doc_gate.py 与 tools/check.py 共用）。",
  "rules": [
    {
      "paths": ["\\.(c|h)$"],
      "docs": ["doc/conventions.md"]
    },
    {
      "paths": ["^(BSP|Framework|User)/", "^cmake/", "^CMakeLists\\.txt$"],
      "docs": ["doc/architecture.md"]
    },
    {
      "paths": ["^Framework/(Control|Drivers|Chassis)/", "^User/board_cfg\\.(c|h)$"],
      "docs": ["doc/units.md"]
    },
    {
      "paths": ["^BSP/", "^Core/", "^User/board_cfg\\.(c|h)$", "\\.ioc$", "\\.ld$", "^startup_.*\\.s$"],
      "docs": ["doc/hardware-map.md"]
    }
  ]
}
